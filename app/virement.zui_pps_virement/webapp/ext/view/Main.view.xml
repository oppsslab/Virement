<mvc:View xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt" controllerName="virement.zuippsvirement.ext.view.Main" height="90%">
    <tnt:ToolPage id="toolPage">
        <tnt:header>
            <OverflowToolbar class="epfCustomBackground overflowToolbarHeader" height="3rem">
                <Image height="3.5rem" src="{LogoImageModel>/CompanyLogo}" visible="{=! ${device>/system/phone}}"/>
                <!-- <Image height="3.5rem" src="./images/EPF_night.png" visible="{=! ${device>/system/phone}}"/> -->
                <ToolbarSeparator />
                <Image height="3.5rem" class="sapUiSmallMarginBegin" src="{LogoImageModel>/AppLogo}" visible="{=! ${device>/system/phone}}"/>
                <!-- <Image height="3.5rem" class="sapUiSmallMarginBegin" src="./images/IFAMSVirement_night.png" visible="{=! ${device>/system/phone}}"/> -->
                <ToolbarSeparator />
                <Title text="{i18n>appTitle}" wrapping="false" class="appTitle"/>
                <ToolbarSpacer />
            </OverflowToolbar>
        </tnt:header>
        <tnt:subHeader>
            <tnt:ToolHeader class="epfCustomBackground">
                <IconTabHeader id="ithMenu" selectedKey="{MenuModel>/selectedKey}" items="{MenuModel>/navigation}" select=".onItemSelect" mode="Inline" backgroundDesign="Transparent" class="headerIconTabBar">
                    <layoutData>
                        <OverflowToolbarLayoutData priority="NeverOverflow" shrinkable="true" />
                    </layoutData>
                    <items>
                        <IconTabFilter text="{path: 'MenuModel>titleI18nKey', formatter: '.getBundleText'}" key="{MenuModel>key}" visible="{MenuModel>visible}"/>
                    </items>
                </IconTabHeader>
            </tnt:ToolHeader>
        </tnt:subHeader>
        <tnt:mainContents>
            <App id="appContent" />
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>