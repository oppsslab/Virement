<mvc:View xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:macros="sap.fe.macros"
    xmlns:html="http://www.w3.org/1999/xhtml" controllerName="virement.zuippsvirement.ext.view.Main"
    xmlns:macrosTable="sap.fe.macros.table">
    <Page id="Main">
        <customHeader>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <Title text="Virement Request Overview"/>
                <ToolbarSpacer/>
            </OverflowToolbar>
        </customHeader>
        <content>
            <macros:Table id="TableRequests" metaPath="/Requests/@com.sap.vocabularies.UI.v1.LineItem#Overview" header="Requests" disableCopyToClipboard="true" enablePaste="false" initialLoad="true" readOnly="true" type="GridTable" isSearchable="false">
                <macros:actions>
                    <macrosTable:Action id="ActionCreate" key="actionCreate" text="{i18n>createRequest}" press=".onCreateRequest" requiresSelection="false"/>
                </macros:actions>
            </macros:Table>
        </content>
    </Page>
</mvc:View>