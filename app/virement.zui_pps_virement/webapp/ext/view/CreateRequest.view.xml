<mvc:View controllerName="virement.zuippsvirement.ext.view.CreateRequest"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:macros="sap.fe.macros"
    xmlns:form="sap.ui.layout.form">
    <f:DynamicPage headerExpanded="false" showFooter="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="Create Request"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <!-- Main content -->
        <f:content>
            <Panel class="sapUiTinyMarginTop">
                <form:SimpleForm editable="true" layout="ColumnLayout" columnsM="2" columnsL="3" columnsXL="4">
                    <form:content>
                        <Label required="true" text="Request Type"/>
                        <macros:Field metaPath="/Requests/requestType_code" id="FieldRequestType" readOnly="false"/>
                    </form:content>
                </form:SimpleForm>
                <Panel class="sapUiTinyMarginTop">
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="Request Header"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    <core:Fragment fragmentName="virement.zuippsvirement.ext.fragment.CreateRequestHeader" type="XML" />
                </Panel>
            </Panel>
        </f:content>

        <!-- Footer aggregation -->
        <f:footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button text="Save as Draft" press="onSaveDraft"/>
                <Button text="Submit" press="onSubmitRequest" type="Emphasized" />
                <Button text="Cancel" press="onPressCancel" />
            </OverflowToolbar>
        </f:footer>
    </f:DynamicPage>
</mvc:View>