{
  "_version": "1.60.0",
  "sap.app": {
    "id": "virement.zuippsvirement",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.79"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:fpm",
      "version": "1.25.0",
      "toolsId": "7d0e463d-5dad-4aaa-bfd8-36f6df6a9267"
    },
    "dataSources": {
      "mainService": {
        "uri": "service/ZSVC_PPS_VIREMENT/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "virementzuippsvirement-display": {
          "semanticObject": "virementzuippsvirement",
          "action": "display",
          "title": "{{virementzuippsvirement-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          },
          "icon": "sap-icon://request"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.149.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.core": {},
        "sap.fe.macros": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "virement.zuippsvirement.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      },
      "MenuModel": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "model/menuData.json"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "rootView": {
      "viewName": "virement.zuippsvirement.ext.view.Main",
      "id": "Main"
    },
    "routing": {
      "config": {
        "controlId": "appContent",
        "controlAggregation": "pages"
      },
      "routes": [
        {
          "name": "Home",
          "pattern": ":?query:",
          "target": "Home"
        },
        {
          "name": "RequestsObjectPage",
          "pattern": "Requests({RequestsKey}):?query:",
          "target": "RequestsObjectPage"
        },
        {
          "name": "VirementRequests",
          "pattern": "VirementRequests:?query:",
          "target": "VirementRequests"
        },
        {
          "name": "RequestsCreate",
          "pattern": "Requests/create:?query:",
          "target": "RequestsCreate"
        }
      ],
      "targets": {
        "Home": {
          "type": "Component",
          "id": "Home",
          "name": "sap.fe.core.fpm",
          "options": {
            "settings": {
              "contextPath": "/Requests",
              "viewName": "virement.zuippsvirement.ext.view.Home"
            }
          }
        },
        "RequestsObjectPage": {
          "type": "Component",
          "id": "RequestsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "navigation": {},
              "contextPath": "/Requests",
              "content": {
                "header": {
                  "anchorBarVisible": false
                }
              },
              "editableHeaderContent": false,
              "controlConfiguration": {
                "RequestHistory/@com.sap.vocabularies.UI.v1.LineItem#History": {
                  "tableSettings": {
                    "disableCopyToClipboard": true,
                    "enableFullScreen": false,
                    "enablePaste": false,
                    "personalization": false,
                    "type": "GridTable"
                  }
                },
                "RequestAttachments/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "disableCopyToClipboard": true,
                    "enableExport": false,
                    "enableFullScreen": false,
                    "enablePaste": false,
                    "type": "ResponsiveTable"
                  }
                },
                "RequestItems/@com.sap.vocabularies.UI.v1.LineItem#SupplementItems": {
                  "tableSettings": {
                    "type": "GridTable"
                  },
                  "columns": {
                    "DataField::srNo": {
                      "width": "6em"
                    }
                  }
                },
                "RequestItems/@com.sap.vocabularies.UI.v1.LineItem#ReturnItems": {
                  "tableSettings": {
                    "type": "GridTable"
                  },
                  "columns": {
                    "DataField::srNo": {
                      "width": "6em"
                    }
                  },
                  "actions": {
                    "downloadTemplate": {
                      "press": "virement.zuippsvirement.ext.controller.ObjectPageCustomActions.onDownloadTemplate",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "{i18n>downloadTemplate}"
                    },
                    "uploadTemplate": {
                      "press": "virement.zuippsvirement.ext.controller.ObjectPageCustomActions.onOpenUploadDialog",
                      "visible": "{= !${ui>/isEditable} ? false : true }",
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "{i18n>UploadTemplate}",
                      "position": {
                        "placement": "Before",
                        "anchor": "downloadTemplate"
                      }
                    }
                  }
                },
                "RequestItems/@com.sap.vocabularies.UI.v1.LineItem#TransferInItems": {
                  "tableSettings": {
                    "type": "GridTable"
                  },
                  "columns": {
                    "DataField::srNo": {
                      "width": "6em"
                    }
                  },
                  "actions": {
                    "downloadTemplate": {
                      "press": "virement.zuippsvirement.ext.controller.ObjectPageCustomActions.onDownloadTemplate",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "{i18n>downloadTemplate}"
                    },
                    "uploadTemplate": {
                      "press": "virement.zuippsvirement.ext.controller.ObjectPageCustomActions.onOpenUploadDialog",
                      "visible": "{= !${ui>/isEditable} ? false : true }",
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "{i18n>UploadTemplate}",
                      "position": {
                        "placement": "Before",
                        "anchor": "downloadTemplate"
                      }
                    }
                  }
                },
                "RequestItems/@com.sap.vocabularies.UI.v1.LineItem#TransferOutItems": {
                  "tableSettings": {
                    "type": "GridTable"
                  },
                  "columns": {
                    "DataField::srNo": {
                      "width": "6em"
                    }
                  }
                },
                "RequestItems/@com.sap.vocabularies.UI.v1.LineItem#TransferFunctional": {
                  "tableSettings": {
                    "type": "GridTable"
                  },
                  "columns": {
                    "DataField::srNo": {
                      "width": "6em"
                    }
                  },
                  "actions": {
                    "downloadTemplate": {
                      "press": "virement.zuippsvirement.ext.controller.ObjectPageCustomActions.onDownloadTemplate",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "{i18n>downloadTemplate}"
                    },
                    "uploadTemplate": {
                      "press": "virement.zuippsvirement.ext.controller.ObjectPageCustomActions.onOpenUploadDialog",
                      "visible": "{= !${ui>/isEditable} ? false : true }",
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "{i18n>UploadTemplate}",
                      "position": {
                        "placement": "Before",
                        "anchor": "downloadTemplate"
                      }
                    }
                  }
                },
                "RequestItems/@com.sap.vocabularies.UI.v1.LineItem#TransferJKEW": {
                  "tableSettings": {
                    "type": "GridTable"
                  },
                  "columns": {
                    "DataField::srNo": {
                      "width": "6em"
                    }
                  },
                  "actions": {
                    "downloadTemplate": {
                      "press": "virement.zuippsvirement.ext.controller.ObjectPageCustomActions.onDownloadTemplate",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "{i18n>downloadTemplate}"
                    },
                    "uploadTemplate": {
                      "press": "virement.zuippsvirement.ext.controller.ObjectPageCustomActions.onOpenUploadDialog",
                      "visible": "{= !${ui>/isEditable} ? false : true }",
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "{i18n>UploadTemplate}",
                      "position": {
                        "placement": "Before",
                        "anchor": "downloadTemplate"
                      }
                    }
                  }
                }
              },
              "enhanceI18n": "i18n/custom-fe.properties"
            }
          }
        },
        "VirementRequests": {
          "type": "Component",
          "id": "VirementRequests",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "navigation": {
                "Requests": {
                  "detail": {
                    "route": "RequestsObjectPage"
                  }
                }
              },
              "contextPath": "/Requests",
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "disableCopyToClipboard": true,
                    "type": "GridTable"
                  }
                }
              },
              "initialLoad": "Enabled",
              "enhanceI18n": "i18n/custom-fe.properties"
            }
          }
        },
        "RequestsCreate": {
          "type": "Component",
          "id": "RequestsCreate",
          "name": "sap.fe.core.fpm",
          "options": {
            "settings": {
              "viewName": "virement.zuippsvirement.ext.view.RequestsCreate",
              "contextPath": "/Requests",
              "navigation": {
                "Requests": {
                  "detail": {
                    "route": "RequestsObjectPage"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "lcap.virement"
  }
}
