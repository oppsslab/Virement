{
  "_version": "1.60.0",
  "sap.app": {
    "id": "virement.zuippsvirement",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.81"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:fpm",
      "version": "1.25.0",
      "toolsId": "7d0e463d-5dad-4aaa-bfd8-36f6df6a9267"
    },
    "dataSources": {
      "mainService": {
        "uri": "service/ZSVC_PPS_VIREMENT/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "virementzuippsvirement-display": {
          "semanticObject": "virementzuippsvirement",
          "action": "display",
          "title": "{{virementzuippsvirement-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          },
          "icon": "sap-icon://request"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "virement.zuippsvirement.ext.controller.ObjectPageExt"
          }
        }
      }
    },
    "dependencies": {
      "minUI5Version": "1.149.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.core": {},
        "sap.fe.macros": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "virement.zuippsvirement.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      },
      "MenuModel": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "model/menuData.json"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "rootView": {
      "viewName": "virement.zuippsvirement.ext.view.Main",
      "id": "Main"
    },
    "routing": {
      "config": {
        "controlId": "appContent",
        "controlAggregation": "pages"
      },
      "routes": [
        {
          "name": "Home",
          "pattern": ":?query:",
          "target": "Home"
        },
        {
          "name": "GroupingMaintenance",
          "pattern": "GroupingMaintenance:?query:",
          "target": "GroupingMaintenance"
        },
        {
          "name": "RequestsObjectPage",
          "pattern": "Requests({RequestsKey}):?query:",
          "target": "RequestsObjectPage"
        },
        {
          "name": "VirementRequests",
          "pattern": "VirementRequests:?query:",
          "target": "VirementRequests"
        },
        {
          "name": "PendingApprovals",
          "pattern": "PendingApprovals:?query:",
          "target": "PendingApprovals"
        },
        {
          "name": "MyRequests",
          "pattern": "MyRequests:?query:",
          "target": "MyRequests"
        },
        {
          "name": "RequestsCreate",
          "pattern": "Requests/create:?query:",
          "target": "RequestsCreate"
        },
        {
          "name": "ApproverMatrix",
          "pattern": "ApproverMatrix:?query:",
          "target": "ApproverMatrix"
        },
        {
          "name": "ApproverMatrixObjectPage",
          "pattern": "ApproverMatrix({ApproverMatrixKey}):?query:",
          "target": "ApproverMatrixObjectPage"
        },
        {
          "name": "GLGrouping",
          "pattern": "GLGrouping:?query:",
          "target": "GLGrouping"
        },
        {
          "name": "GLGroupingObjectPage",
          "pattern": "GLGrouping({GLGroupingKey}):?query:",
          "target": "GLGroupingObjectPage"
        },
        {
          "name": "DepartmentGrouping",
          "pattern": "DepartmentGrouping:?query:",
          "target": "DepartmentGrouping"
        },
        {
          "name": "DepartmentGroupingObjectPage",
          "pattern": "DepartmentGrouping({DepartmentGroupingKey}):?query:",
          "target": "DepartmentGroupingObjectPage"
        },
        {
          "name": "FunctionalDepartmentGrouping",
          "pattern": "FunctionalDepartmentGrouping:?query:",
          "target": "FunctionalDepartmentGrouping"
        },
        {
          "name": "FunctionalDepartmentGroupingObjectPage",
          "pattern": "FunctionalDepartmentGrouping({FunctionalDepartmentGroupingKey}):?query:",
          "target": "FunctionalDepartmentGroupingObjectPage"
        },
        {
          "name": "BuildingGrouping",
          "pattern": "BuildingGrouping:?query:",
          "target": "BuildingGrouping"
        },
        {
          "name": "BuildingGroupingObjectPage",
          "pattern": "BuildingGrouping({BuildingGroupingKey}):?query:",
          "target": "BuildingGroupingObjectPage"
        },
        {
          "name": "RegionBranchGrouping",
          "pattern": "RegionBranchGrouping:?query:",
          "target": "RegionBranchGrouping"
        },
        {
          "name": "RegionBranchGroupingObjectPage",
          "pattern": "RegionBranchGrouping({RegionBranchGroupingKey}):?query:",
          "target": "RegionBranchGroupingObjectPage"
        }
      ],
      "targets": {
        "Home": {
          "type": "Component",
          "id": "Home",
          "name": "sap.fe.core.fpm",
          "options": {
            "settings": {
              "contextPath": "/Requests",
              "viewName": "virement.zuippsvirement.ext.view.Home"
            }
          }
        },
        "GroupingMaintenance": {
          "type": "Component",
          "id": "GroupingMaintenance",
          "name": "sap.fe.core.fpm",
          "options": {
            "settings": {
              "contextPath": "/Requests",
              "viewName": "virement.zuippsvirement.ext.view.GroupingMaintenance"
            }
          }
        },
        "RequestsObjectPage": {
          "type": "Component",
          "id": "RequestsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "navigation": {},
              "contextPath": "/Requests",
              "content": {
                "header": {
                  "anchorBarVisible": false
                }
              },
              "editableHeaderContent": false,
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.FieldGroup#RequestHeader": {
                  "fields": {
                    "ReturnCategory": {
                      "template": "virement.zuippsvirement.ext.fragment.ReturnCategoryField",
                      "label": "{i18n>ReturnCategory}",
                      "property": "returnCategory_code",
                      "visible": "{= %{requestType_code} === 'R' }",
                      "position": {
                        "placement": "After",
                        "anchor": "DataField::budgetType_code"
                      }
                    },
                    "DataField::earmarkedFundsDocNumber": {
                      "template": "virement.zuippsvirement.ext.fragment.EarmarkedFundsDocNumberField",
                      "label": "{i18n>EarmarkedFundsDocNumber}",
                      "visible": "{= %{requestType_code} === 'T' && %{transferOutAmount} > 0 && %{budgetType_code} !== 'P' }"
                    },
                    "DataField::supplementDocNumber": {
                      "template": "virement.zuippsvirement.ext.fragment.SupplementDocNumberField"
                    },
                    "DataField::returnDocNumber": {
                      "template": "virement.zuippsvirement.ext.fragment.ReturnDocNumberField"
                    },
                    "DataField::transferOutDocNumber": {
                      "template": "virement.zuippsvirement.ext.fragment.TransferOutInDocNumberField"
                    }
                  }
                },
                "@com.sap.vocabularies.UI.v1.FieldGroup#WorkflowInfo": {
                  "fields": {
                    "WorkflowInstanceId": {
                      "template": "virement.zuippsvirement.ext.fragment.WorkflowInstanceIdLink",
                      "label": "{i18n>InstanceId}",
                      "property": "workflowInstanceId",
                      "position": {
                        "placement": "Before",
                        "anchor": "DataField::workflowStatus"
                      }
                    },
                    "DataField::workflowStatus": {
                      "template": "virement.zuippsvirement.ext.fragment.WorkflowStatusField",
                      "label": "{i18n>Status}"
                    }
                  }
                },
                "RequestHistory/@com.sap.vocabularies.UI.v1.LineItem#History": {
                  "tableSettings": {
                    "disableCopyToClipboard": true,
                    "enableFullScreen": false,
                    "enablePaste": false,
                    "personalization": false,
                    "type": "GridTable"
                  }
                },
                "RequestAttachments/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "disableCopyToClipboard": true,
                    "enableExport": false,
                    "enableFullScreen": false,
                    "enablePaste": false,
                    "type": "ResponsiveTable"
                  }
                },
                "RequestItems/@com.sap.vocabularies.UI.v1.LineItem#SupplementItems": {
                  "tableSettings": {
                    "type": "GridTable"
                  },
                  "columns": {
                    "DataField::srNo": {
                      "width": "6em"
                    }
                  },
                  "actions": {
                    "downloadTemplate": {
                      "press": "virement.zuippsvirement.ext.controller.ObjectPageCustomActions.onDownloadTemplate",
                      "visible": "{= %{status_code} === 0 }",
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "{i18n>downloadTemplate}"
                    },
                    "uploadTemplate": {
                      "press": "virement.zuippsvirement.ext.controller.ObjectPageCustomActions.onOpenUploadDialog",
                      "visible": "{= %{status_code} === 0 }",
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "{i18n>UploadTemplate}",
                      "position": {
                        "placement": "Before",
                        "anchor": "downloadTemplate"
                      }
                    }
                  }
                },
                "RequestItems/@com.sap.vocabularies.UI.v1.LineItem#ReturnItems": {
                  "tableSettings": {
                    "type": "GridTable"
                  },
                  "columns": {
                    "DataField::srNo": {
                      "width": "6em"
                    }
                  },
                  "actions": {
                    "downloadTemplate": {
                      "press": "virement.zuippsvirement.ext.controller.ObjectPageCustomActions.onDownloadTemplate",
                      "visible": "{= %{status_code} === 0 }",
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "{i18n>downloadTemplate}"
                    },
                    "uploadTemplate": {
                      "press": "virement.zuippsvirement.ext.controller.ObjectPageCustomActions.onOpenUploadDialog",
