                      "enabled": true,
                      "requiresSelection": false,
                      "text": "{i18n>UploadTemplate}",
                      "position": {
                        "placement": "Before",
                        "anchor": "downloadTemplate"
                      }
                    }
                  }
                },
                "RequestItems/@com.sap.vocabularies.UI.v1.LineItem#TransferInOutItems": {
